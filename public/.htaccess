Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_headers.c>
    # Common security headers for HTML, API and static assets.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

    # Versioned CSS and JavaScript URLs can be cached for a long period.
    <FilesMatch "\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Fonts and images are not all versioned from PHP, so keep a shorter policy.
    <FilesMatch "\.(?:woff2?|ttf|png|jpe?g|gif|svg|ico)$">
        Header always set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<FilesMatch "(^\.|\.(?:env|ini|log|sql|sqlite|db|bak|backup|old|orig|swp|tmp|dist)$)">
    Require all denied
</FilesMatch>

Options -Indexes

RewriteEngine On

# V1.19-C: public/で直接実行可能なPHPはPublic Endpoint Matrixで明示的に固定する。
# V1.22-A: authenticated RSS management page is an explicit public endpoint.
# V1.25-D: recurring Calendar API is an explicit authenticated public endpoint.
# V1.27-D: Secure File Upload API is authenticated + CSRF protected.
# V1.27-E: File Library page/content endpoint are authenticated and owner-scoped.
# V1.28-B: File Detail API is authenticated, owner-scoped and read-only.
# V1.29-I: Remote File Manager page/content/preview/upload endpoints are explicit authenticated endpoints.
# V1.30-B: Remote Text Editor read API is authenticated, owner-scoped and read-only.
RewriteRule ^(?!api_v1\.php$|calendar_color_api\.php$|calendar_recurrence_api\.php$|connection_probe\.php$|error\.php$|file-library\.php$|file_content\.php$|file_preview_api\.php$|file_upload_api\.php$|index\.php$|logout\.php$|remote-files\.php$|remote_file_content\.php$|remote_file_editor_api\.php$|remote_file_preview_api\.php$|remote_file_upload_api\.php$|rss-management\.php$|settings\.php$|stock\.php$).*\.php$ - [F,L,NC]

# V1.13-B R2: DocumentRootがpublic/直下の場合も /stock をCanonical URLとする。
# Application Root配下の /public/stock.php が直接指定された場合も /stock へ戻す。
# Subdirectory設置時もURLのPrefixを保つ。
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/stock\.php(?:[?\s]) [NC]
RewriteRule ^stock\.php$ /%1stock [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?stock\.php(?:[?\s]) [NC]
RewriteRule ^stock\.php$ /%1stock [R=302,L,NE]

# 実体stock.phpへ内部Rewrite。Query Stringは維持する。
RewriteRule ^stock/?$ stock.php [L,QSA]

# V1.13-C: DocumentRootがpublic/直下の場合も /settings をCanonical URLとする。
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/settings\.php(?:[?\s]) [NC]
RewriteRule ^settings\.php$ /%1settings [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?settings\.php(?:[?\s]) [NC]
RewriteRule ^settings\.php$ /%1settings [R=302,L,NE]

# 実体settings.phpへ内部Rewrite。
RewriteRule ^settings/?$ settings.php [L,QSA]

# V1.22-A: RSS management canonical endpoint.
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/rss-management\.php(?:[?\s]) [NC]
RewriteRule ^rss-management\.php$ /%1rss-management [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?rss-management\.php(?:[?\s]) [NC]
RewriteRule ^rss-management\.php$ /%1rss-management [R=302,L,NE]
RewriteRule ^rss-management/?$ rss-management.php [L,QSA]

# V1.27-E: File Library canonical endpoint.
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/file-library\.php(?:[?\s]) [NC]
RewriteRule ^file-library\.php$ /%1file-library [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?file-library\.php(?:[?\s]) [NC]
RewriteRule ^file-library\.php$ /%1file-library [R=302,L,NE]
RewriteRule ^file-library/?$ file-library.php [L,QSA]

# V1.29-I: Remote Files canonical endpoint.
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/remote-files\.php(?:[?\s]) [NC]
RewriteRule ^remote-files\.php$ /%1remote-files [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?remote-files\.php(?:[?\s]) [NC]
RewriteRule ^remote-files\.php$ /%1remote-files [R=302,L,NE]
RewriteRule ^remote-files/?$ remote-files.php [L,QSA]

# 実在するファイル・ディレクトリはそのまま返す
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# それ以外は共通404画面へ渡す
RewriteRule ^ - [R=404,L]

# Current rental-server layout keeps public/ below the visible application root.
# If Apache DocumentRoot points directly to public/, change /public/error.php to /error.php.
# For a subdirectory install, prefix the path, for example: /rss/public/error.php.
ErrorDocument 403 /public/error.php
ErrorDocument 404 /public/error.php
ErrorDocument 500 /public/error.php
ErrorDocument 503 /public/error.php
