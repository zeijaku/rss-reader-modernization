# Secure Baseline application root.
# Web DocumentRoot must be the public/ directory.
# Intentionally do NOT set session.save_path here; PHP configures a private
# var/session directory before session_start().
Options -Indexes -MultiViews

Options -Indexes

RewriteEngine On

# V1.13-B R2: Stockは拡張子を見せない /stock をCanonical URLとする。
# 直接stock.phpへアクセスされた場合だけ302で /stock へ戻す。
# THE_REQUESTを見ることで /stock -> public/stock.php の内部RewriteではRedirectしない。
# Subdirectory設置時もURLのPrefixを保つ。
RewriteCond %{THE_REQUEST} \s/+(.*/)?public/stock\.php(?:[?\s]) [NC]
RewriteRule ^public/stock\.php$ /%1stock [R=302,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?stock\.php(?:[?\s]) [NC]
RewriteRule ^stock\.php$ /%1stock [R=302,L,NE]

# 実体はpublic/stock.phpのまま維持し、Query Stringもそのまま渡す。
RewriteRule ^stock/?$ public/stock.php [L,QSA]

# Common error page for the current server layout (application root -> public/ internal rewrite).
# For a subdirectory install, prefix the path, for example: /rss/public/error.php
ErrorDocument 403 /public/error.php
ErrorDocument 404 /public/error.php
ErrorDocument 500 /public/error.php
ErrorDocument 503 /public/error.php

# 非公開にしたいディレクトリへのアクセスを拒否
RewriteRule ^(?:app|config|tools|var)(?:/|$) - [F,L,NC]

# public配下へ内部転送済みの場合は再転送しない
RewriteRule ^public(?:/|$) - [L]

# public配下に実在するファイル・ディレクトリがある場合
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.+)$ public/$1 [L]

# トップページ
RewriteRule ^$ public/index.php [L]

# それ以外はpublic側へ転送
RewriteRule ^(.+)$ public/$1 [L]