# This project does not load .env files by itself.
# Use these names in the hosting control panel, Web server, PHP-FPM, or process environment.
APP_ENV=production
APP_DEBUG=false
APP_LOG_ENABLED=false
APP_LOG_PATH=/absolute/private/path/rss-reader/access.log
APP_ERROR_LOG_PATH=/absolute/private/path/rss-reader/error.log
APP_HASH_KEY=replace-with-a-long-random-secret-at-least-32-characters

REGISTRATION_ENABLED=true
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=72
SESSION_COOKIE_NAME=iguguru_session
SESSION_IDLE_TIMEOUT=7200
SESSION_ABSOLUTE_TIMEOUT=43200
LOGIN_RATE_WINDOW=900
LOGIN_RATE_MAX_PAIR=5
LOGIN_RATE_MAX_IP=30
LOGIN_RATE_BLOCK_SECONDS=900

APP_HTTP_CONNECT_TIMEOUT_MS=3000
APP_HTTP_TIMEOUT_MS=8000
APP_HTTP_MAX_REDIRECTS=3
APP_HTTP_MAX_BYTES=2097152
APP_HTTP_USER_AGENT=iGuguru-RSS/1.0 (+Secure-Baseline)

APP_FEED_CACHE_ENABLED=true
APP_FEED_CONDITIONAL_REQUEST_ENABLED=true
APP_FEED_CACHE_TTL_SECONDS=60
APP_FEED_CACHE_LOCK_TIMEOUT_MS=9000
APP_FEED_RETRY_ENABLED=true
APP_FEED_RETRY_MAX_DELAY_SECONDS=3600
APP_FEED_STALE_IF_ERROR_ENABLED=true
APP_FEED_STALE_MAX_AGE_SECONDS=86400
APP_FEED_ITEM_STATE_RETENTION_DAYS=90

DB_DRIVER=mysql
DB_HOST=replace-with-your-db-host
DB_PORT=3306
DB_NAME=replace-with-your-db-name
DB_USER=replace-with-your-db-user
DB_PASSWORD=replace-with-a-strong-password
DB_TABLE_PREFIX=rss_
