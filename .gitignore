!/var/cache/
!/var/cache/.gitkeep
!/var/cache/feed/
!/var/cache/feed/.gitkeep
/var/cache/feed/*
!/var/cache/feed/.gitkeep
!/var/session/
!/var/session/.gitkeep
/var/session/*
!/var/session/.gitkeep
/public/session_file/
/public/dat/
/session_file/
/dat/
*.log
*.pid

